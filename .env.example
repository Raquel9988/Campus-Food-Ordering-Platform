# PayFast Sandbox Settings
PAYFAST_MODE=sandbox
PAYFAST_MERCHANT_ID=your_sandbox_merchant_id_here
PAYFAST_MERCHANT_KEY=your_sandbox_merchant_key_here
PAYFAST_PASSPHRASE=

PAYFAST_PROCESS_URL=https://sandbox.payfast.co.za/eng/process
PAYFAST_RETURN_URL=https://your-cloudflare-site.pages.dev/payment-success.html
PAYFAST_CANCEL_URL=https://your-cloudflare-site.pages.dev/payment-cancelled.html
PAYFAST_NOTIFY_URL=https://your-cloudflare-site.pages.dev/api/payfast/notify

# Supabase Settings
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_key_here